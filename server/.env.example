# Use Render environment variables in production.
# On Render, do not set PORT here; Render provides it automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.konpul3.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key
CLIENT_URL=http://localhost:5173 # optional if frontend and backend are served from same Railway service
